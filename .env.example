# ── Mention 回复模型（固定 DeepSeek Vision）──────────────────────────
MENTION_CHAT_PROVIDER=deepseek
# 可选：把文字模型指向任意 OpenAI 兼容端点（设置页保存的配置会覆盖它）
# MENTION_BASE_URL=https://api.deepseek.com

# ── DeepSeek 大模型（OpenAI 兼容接口）──────────────────────────────────
# 申请地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# 网页与论坛 Agent 固定使用该模型，不启用 fallback
DEEPSEEK_MENTION_MODEL=deepseek-v4-flash-vision-exp
# chat_completions 或 responses；线上使用 responses
DEEPSEEK_MENTION_API_FORMAT=responses
DEEPSEEK_MENTION_THINKING=enabled
# 调查轮（规划工具调用）与收尾轮（生成正文）的推理强度：low / high / max
DEEPSEEK_MENTION_REASONING_EFFORT=high
DEEPSEEK_MENTION_FINAL_REASONING_EFFORT=high
# 单次模型请求的硬上限秒数；整轮预算见 deployment.toml [common.runtime].timeout
DEEPSEEK_MENTION_REQUEST_TIMEOUT=180
# DEEPSEEK_MENTION_MAX_TOKENS=4096

# ── Pet 模型配置 ──────────────────────────────────────────────────────
# Pet 回复使用的模型（默认 deepseek-v4-pro，也可设为 qwen3-max 等）
PET_REPLY_MODEL=deepseek-v4-pro

# ── 图像生成模型 ──────────────────────────────────────────────────────
IMAGE_GEN_API_KEY=                  # Right Code API key: sk-xxxxx
IMAGE_GEN_API_URL=https://www.right.codes/draw/v1/chat/completions
IMAGE_GEN_MODEL=gpt-image-2
IMAGE_GEN_STREAM=true             
IMAGE_GEN_TIMEOUT_SECONDS=600       # Per-request timeout
IMAGE_GEN_MAX_ATTEMPTS=3            # Retries are new billable submissions; no resume API is documented
IMAGE_GEN_RETRY_BASE_DELAY_SECONDS=5
# This tool always sends 1K images to limit upstream response time.

# ── 数据库连接 ────────────────────────────────────────────────────────
# Primary Postgres database for quote records and, by default, LangMem memory.
POSTGRES_DB_URL=postgresql://shuiyuan:password@localhost:5432/shuiyuan
# Backward-compatible record database URL used only when the URLs above are empty.
POSTGRES_URI=
POSTGRES_STRICT=false
# Optional override if record tables should use a different Postgres database.
POSTGRES_RECORD_DB_URL=
POSTGRES_RECORD_STRICT=false
# Optional override if LangMem memory should use a different Postgres database.
POSTGRES_MEMORY_DB_URL=
POSTGRES_MEMORY_STRICT=false

# Neo4j database configuration
NEO4J_DB_URL=bolt://localhost:7687
NEO4J_DB_AUTH=("neo4j", "password")
NEO4J_STRICT=false

# Number of long-term memory items injected before model calls.
LANGMEM_SEARCH_LIMIT=5
# Max characters of formatted long-term memory context injected into the prompt.
LANGMEM_CONTEXT_MAX_CHARS=1600

# The embedding model to use for vectorizing text.
EMBEDDING_MODEL_NAME=moka-ai/m3e-base
EMBEDDING_CACHE_FOLDER=
EMBEDDING_DIMS=768

# ── MCP 服务 ──────────────────────────────────────────────────────────
MCP_SERVER_URL=http://localhost:8000/sse

# Local management UI state. Defaults to ~/.shuiyuan-auto-reply
# SHUIYUAN_STATE_DIR=

# Deployment TOML is authoritative when selected with --config/--profile.
# Legacy-compatible optional settings (secrets may use TOML env/file references).
# SHUIYUAN_COOKIE_FILE=cookies
# SHUIYUAN_BOT_USERNAME=wolf_lumine
# EMBEDDING_BACKEND=local
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=

# Optional release label for task diagnostics; otherwise the installed package version is used.
# SHUIYUAN_RELEASE_VERSION=vX.Y.Z
