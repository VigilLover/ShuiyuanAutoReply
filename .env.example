# ── DeepSeek 大模型（OpenAI 兼容接口）──────────────────────────────────
# 申请地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Mention 模块使用的 DeepSeek 模型（可选 deepseek-v4-pro / deepseek-v4-flash）
DEEPSEEK_MENTION_MODEL=deepseek-v4-pro
# DeepSeek 内部 fallback 模型（主模型不可用时自动切换）
DEEPSEEK_MENTION_FALLBACK_MODEL=deepseek-v4-flash

# ── 通义千问（DashScope 接口）────────────────────────────────────────
# 申请地址: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=
# Mention 模块使用的通义千问模型（可选 qwen3.5-plus-2026-02-15 / qwen3.5-plus 等）
DASHSCOPE_MENTION_MODEL=qwen3.5-plus-2026-02-15
# 通义千问内部 fallback 模型（主模型不可用时自动切换）
DASHSCOPE_MENTION_FALLBACK_MODEL=qwen3.5-plus

# ── OpenRouter（多模型聚合网关）────────────────────────────────────────
# 申请地址: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite-preview
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image-preview
OPENROUTER_MENTION_MODEL=
OPENROUTER_TAROT_MODEL=
OPENROUTER_TAROT_GROUP_MODEL=

# ── Pet 模型配置 ──────────────────────────────────────────────────────
# Pet 回复使用的模型（默认 deepseek-v4-pro，也可设为 qwen3-max 等）
PET_REPLY_MODEL=deepseek-v4-pro

# ── 图像生成模型 ──────────────────────────────────────────────────────
IMAGE_GEN_API_KEY=
IMAGE_GEN_API_URL=
IMAGE_GEN_MODEL=

# ── 数据库连接 ────────────────────────────────────────────────────────
MYSQL_DB_URL=mysql+aiomysql://user:passwd@localhost:3306/dbname
# Neo4j 向量数据库（语气检索用）
NEO4J_DB_URL=bolt://localhost:7687
NEO4J_DB_AUTH=("neo4j", "password")

# ── MCP 服务 ──────────────────────────────────────────────────────────
MCP_SERVER_URL=http://localhost:8000/sse

# ── HuggingFace 镜像端点 ──────────────────────────────────────────────
HF_ENDPOINT=https://hf-mirror.com
